{
  "protocol_version": "1.0",
  "name": "ollama-devstral-metered-neutral",
  "command": [
    "py",
    "-X",
    "utf8",
    "{harness_root}\\adapters\\ollama_context_adapter.py",
    "--model",
    "devstral-small-2:latest",
    "--context-length",
    "32768",
    "--num-predict",
    "2048",
    "--response-discipline",
    "neutral",
    "--context-file",
    "skills/software-verification/SKILL.md",
    "--context-file",
    "skills/software-verification/references/core/metered-verification.md",
    "--context-file",
    "skills/software-verification/references/core/release-assessment.md",
    "--context-file",
    "skills/software-verification/assets/templates/metered-verification-response.md"
  ],
  "input_mode": "prompt",
  "output_mode": "stdout",
  "supports_interaction": false,
  "timeout_seconds": 1800,
  "working_directory": "{package_root}",
  "tracked_files": [
    "{harness_root}\\adapters\\ollama_context_adapter.py"
  ]
}
