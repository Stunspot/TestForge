{
  "protocol_version": "1.0",
  "name": "ollama-qwen25-coder-judge",
  "command": [
    "py",
    "-X",
    "utf8",
    "{harness_root}\\adapters\\ollama_context_adapter.py",
    "--model",
    "qwen2.5-coder:14b",
    "--context-length",
    "32768",
    "--num-predict",
    "2048",
    "--thinking",
    "off"
  ],
  "input_mode": "prompt",
  "output_mode": "stdout",
  "supports_interaction": false,
  "timeout_seconds": 1800,
  "working_directory": "{package_root}",
  "tracked_files": [
    "{harness_root}\\adapters\\ollama_context_adapter.py"
  ]
}
